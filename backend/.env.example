# =============================================================================
# Church Nexus – Environment Variable Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to `.env`  →  cp .env.example .env
#   2. Fill in every value marked with <REPLACE_ME>
#   3. NEVER commit the real `.env` file to version control
#   4. Keep the real `.env` out of Docker images (use --env-file or secrets)
# =============================================================================

# ---------------------------------------------------------------------------
# Core Django Settings
# ---------------------------------------------------------------------------
# SECURITY WARNING: generate a unique key for every environment.
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<REPLACE_ME>

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Individual vars used by docker-compose
DB_NAME=church_db
DB_USER=<REPLACE_ME>
DB_PASSWORD=<REPLACE_ME>

# ---------------------------------------------------------------------------
# Redis (Celery Broker & Result Backend)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://<REDIS_HOST>:6379/0
CELERY_RESULT_BACKEND=redis://<REDIS_HOST>:6379/0
REDIS_HOST=redis

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------
# Maximum allowed file upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE=10485760

# ---------------------------------------------------------------------------
# Email Configuration (SMTP / Console Fallback)
# ---------------------------------------------------------------------------
# For production/SMTP email dispatch, configure these values.
# If EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are not both defined,
# the system automatically falls back to Django's console email backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<REPLACE_WITH_GMAIL_ADDRESS>
EMAIL_HOST_PASSWORD=<REPLACE_WITH_GMAIL_APP_PASSWORD>
DEFAULT_FROM_EMAIL=<REPLACE_WITH_GMAIL_ADDRESS>

# ---------------------------------------------------------------------------
# Testing (SQLite used when running pytest)

# ---------------------------------------------------------------------------
# Override for test-only database. Defaults to SQLite if not set.
# TEST_DATABASE_URL=sqlite:///./test_db.sqlite3

# ---------------------------------------------------------------------------
# Security Notes
# ---------------------------------------------------------------------------
# • SECRET_KEY  — must be at least 50 characters, random, unique per env
# • DB_PASSWORD — use a strong password (≥20 chars, mixed case + symbols)
# • Never expose these values in logs, error responses, or API output
# • Rotate credentials immediately if a leak is suspected
# =============================================================================
